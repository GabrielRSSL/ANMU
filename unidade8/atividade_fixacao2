dados <- data.frame(
  Ensino = factor(c(
    rep("Presencial",10),
    rep("Hibrido",10),
    rep("EAD",10))),
  Matematica = c(
    82,85,88,79,90,84,87,91,86,83,
    75,78,80,77,79,81,76,74,82,78,
    68,70,72,66,71,69,73,67,65,74),
